@page "/"
@inject HttpClient Http
@inject IJSRuntime JS
@using DesignerIA.Contracts

<PageTitle>DesignerIA</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-brand">
            <span class="app-header-brand-name">DesignerIA</span>
            <span class="app-header-brand-tagline">Asistente para la creación de vistas de GestionEngine</span>
        </div>
        <div class="app-header-indicators">
            <span class="status-badge @ClaseBadge(EstadoApi)"><span class="status-badge-dot"></span>API: @EtiquetaApi</span>
            <span class="status-badge @ClaseBadge(EstadoGestionEngine)"><span class="status-badge-dot"></span>GestionEngine: @EtiquetaGestionEngine</span>
            <span class="status-badge @ClaseBadge(EstadoCopilot)"><span class="status-badge-dot"></span>Copilot: @EtiquetaCopilot</span>
        </div>
    </header>

    <div class="workspace-content @(_seccionVista ? "workspace-content-editor" : null) @(_seccionVista && _asistenteVisible && !_editorAmpliado ? "workspace-content-assistant" : null) @(_seccionVista && _editorAmpliado ? "workspace-content-focus" : null)">
        <nav class="nav-rail">
            <button type="button" class="workspace-nav-button @(!_seccionVista ? "workspace-nav-selected" : null)" aria-current="@(!_seccionVista ? "page" : null)" disabled="@_editorOcupado" @onclick="MostrarConversaciones">Conversaciones</button>
            <RadzenButton Text="+ Nueva conversación" ButtonStyle="Radzen.ButtonStyle.Light" Click="@(() => { MostrarConversaciones(); NuevaConversacion(); })" Disabled="@(_enviando || _editorOcupado)" />
            <button id="prepare-view-nav" type="button" class="workspace-nav-button @(_seccionVista ? "workspace-nav-selected" : null)" aria-current="@(_seccionVista ? "page" : null)" disabled="@(_creandoVista || _editorOcupado)" @onclick="AbrirPreparacion">Preparar vista</button>
            <div class="nav-rail-placeholder">El historial de conversaciones estará disponible próximamente.</div>

            <div class="nav-rail-secondary">
                <button type="button" class="nav-rail-secondary-action" disabled="@_actualizandoConocimiento" @onclick="@ActualizarConocimientoAsync">
                    @(_actualizandoConocimiento ? "Actualizando..." : "Actualizar conocimiento")
                </button>
                @if (_ultimoRebuild is not null)
                {
                    <span class="nav-rail-secondary-status">
                        @(_ultimoRebuild.Status == "ok"
                            ? $"{_ultimoRebuild.ChunksCreated} fragmentos de {_ultimoRebuild.FilesIndexed} documentos ({_ultimoRebuild.FilesUnsupported} no soportados)"
                            : "No se pudo actualizar")
                    </span>
                }
                <button type="button" class="nav-rail-secondary-action" @onclick="AbrirLaboratorioAsync">Laboratorio de conocimiento</button>
            </div>
        </nav>

        @if (_edicionVista.Content is not null)
        {
            <section class="jsonmeta-workspace-host" hidden="@(!_seccionVista)">
                <JsonMetadataWorkspace Editor="_edicionVista" FileName="@_archivoVista" IsActive="_seccionVista" AssistantVisible="_asistenteVisible" OnLoadFile="@(() => _mostrarCrearVistaJson = true)" OnToggleAssistant="@(() => _asistenteVisible = !_asistenteVisible)" OnExpandedChanged="@((bool expanded) => _editorAmpliado = expanded)" OnBusyChanged="@((bool busy) => _editorOcupado = busy)" OnCreationFinished="MostrarResultadoCreacionJson" />
            </section>
        }

        <section class="chat-panel @(_seccionVista ? "chat-panel-assistant" : null)" hidden="@(_seccionVista && (!_asistenteVisible || _editorAmpliado))">
            @if (_seccionVista)
            {
                <div class="jsonmeta-assistant-heading">Conversación de conocimiento</div>
                <div class="jsonmeta-needed">Consulta información de GestionEngine. El borrador se ajusta desde el editor.</div>
            }
            <RadzenCard Variant="Radzen.Variant.Flat" class="chat-scroll">
                @if (_mensajes.Count == 0)
                {
                    <div>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.H4" class="chat-welcome-title">Hola, soy DesignerIA</RadzenText>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Body1" class="chat-welcome-subtitle">
                            Hoy puedo ayudarte con información básica y real de GestionEngine. Escribe tu pregunta o
                            elige una de las siguientes opciones.
                        </RadzenText>
                        <div class="prompt-starters">
                            @foreach (var starter in _promptStarters)
                            {
                                <button type="button" class="prompt-starter-chip" disabled="@_enviando" @onclick="@(() => EnviarStarterAsync(starter))">@starter</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var mensaje in _mensajes)
                    {
                        <div class="chat-message @(mensaje.EsUsuario ? "chat-message-user" : "chat-message-assistant") @(mensaje.EsError ? "chat-message-error" : "")">
                            <span class="chat-message-author">@(mensaje.EsUsuario ? "Tú" : "DesignerIA")</span>
                            @if (mensaje.EsCreacionVista && mensaje.VistaValida)
                            {
                                <div class="chat-createview-progress">
                                    <div>Ok, prepararé la vista <strong>@mensaje.NombreVista</strong>.</div>
                                    <div class="chat-createview-steps">
                                        <span>✓ Solicitud interpretada</span>
                                        <span>✓ Estructura generada</span>
                                        <span>✓ Validación completada</span>
                                        <span>✓ Vista lista para generar script</span>
                                    </div>
                                    <div class="chat-createview-notice">Vista preparada correctamente. Aún no se ha creado en GestionEngine.</div>
                                </div>
                            }
                            else
                            {
                                @if (!mensaje.EsUsuario && !mensaje.EsError && !mensaje.EsCreacionVista)
                                {
                                    <div class="chat-bubble chat-bubble-markdown">@mensaje.Html</div>
                                }
                                else
                                {
                                    <div class="chat-bubble">@mensaje.Texto</div>
                                }
                            }
                            @if (mensaje.ToolInvoked)
                            {
                                <span class="chat-message-meta">Consultado en GestionEngine</span>
                            }
                            @if (!mensaje.EsCreacionVista && mensaje.Fuentes is { Count: > 0 })
                            {
                                <div class="chat-sources">
                                    <span class="chat-sources-title">Fuentes consultadas</span>
                                    <ul class="chat-sources-list">
                                        @foreach (var fuente in mensaje.Fuentes)
                                        {
                                            @if (fuente.SourceType == "Curated")
                                            {
                                                <li>
                                                    <span class="chat-sources-curated-badge">Conocimiento del equipo</span>
                                                    @fuente.Title
                                                    @if (!string.IsNullOrWhiteSpace(fuente.Contributor))
                                                    {
                                                        <span class="chat-sources-file">(Aportado por: @fuente.Contributor)</span>
                                                    }
                                                </li>
                                            }
                                            else
                                            {
                                                <li>@fuente.Title <span class="chat-sources-file">(@fuente.SourceFile)</span></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    @if (_enviando)
                    {
                        <div class="chat-working" role="status">
                            <RadzenProgressBarCircular Mode="Radzen.ProgressBarMode.Indeterminate" Value="100" ShowValue="false" Style="width:1rem;height:1rem;" />
                            <span>DesignerIA está trabajando...</span>
                        </div>
                    }
                }
            </RadzenCard>

            <div class="composer">
                <textarea class="composer-textarea" placeholder="Escribe tu pregunta para DesignerIA..." rows="1"
                          @bind="_mensajeActual" @bind:event="oninput" disabled="@_enviando"></textarea>
                <RadzenButton Text="Enviar" ButtonStyle="Radzen.ButtonStyle.Primary" Click="@EnviarAsync" Disabled="@(_enviando || string.IsNullOrWhiteSpace(_mensajeActual))">
                    @if (_enviando)
                    {
                        <RadzenProgressBarCircular Mode="Radzen.ProgressBarMode.Indeterminate" Value="100" ShowValue="false" Style="width:1rem;height:1rem;margin-left:0.35rem;" />
                    }
                </RadzenButton>
            </div>
        </section>

        <aside class="context-panel" hidden="@_seccionVista">
            <RadzenCard Variant="Radzen.Variant.Flat">
                <RadzenStack Gap="1.1rem">
                    <div>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="context-panel-section-title">GestionEngine</RadzenText>
                        <div class="context-panel-row">
                            <span class="status-badge @ClaseBadge(EstadoGestionEngine)"><span class="status-badge-dot"></span>@EtiquetaGestionEngine</span>
                            <RadzenButton Text="Reintentar" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.ExtraSmall" Click="@ConsultarEstadoBaseDatosAsync" Disabled="@_cargandoBaseDatos" />
                        </div>
                        @if (_estadoBaseDatos is not null)
                        {
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Caption">Vistas registradas: @_estadoBaseDatos.ViewsCount</RadzenText>
                        }
                    </div>

                    <div>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="context-panel-section-title">Copilot</RadzenText>
                        <span class="status-badge @ClaseBadge(EstadoCopilot)"><span class="status-badge-dot"></span>@EtiquetaCopilot</span>
                    </div>

                    <div>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="context-panel-section-title">Sesión DesignerIA</RadzenText>
                        @if (_cargandoIdentidadApi)
                        {
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Caption">Verificando identidad...</RadzenText>
                        }
                        else if (_identidadApi is { IsAuthenticated: true })
                        {
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Caption">@_identidadApi.Name</RadzenText>
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Caption">@_identidadApi.AuthenticationType</RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Caption">No autenticada</RadzenText>
                        }
                    </div>

                    <div>
                        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="context-panel-section-title">Vista en progreso</RadzenText>
                        @if (_vistaEnProgreso is null)
                        {
                            <div class="artifact-placeholder">Sin vista en progreso</div>
                        }
                        else
                        {
                            <div class="viewspec-panel">
                                <div class="viewspec-name">@(_vistaEnProgreso.Spec.Name ?? "(vista sin nombre)")</div>
                                @if (!string.IsNullOrWhiteSpace(_vistaEnProgreso.Spec.ViewType))
                                {
                                    <div class="viewspec-summary-detail">Tipo de vista: @_vistaEnProgreso.Spec.ViewType</div>
                                }

                                @foreach (var estado in _vistaEnProgreso.Spec.States ?? Array.Empty<ViewSpecState>())
                                {
                                    <div class="viewspec-state">
                                        <div class="viewspec-state-title">
                                            @(estado.Name ?? "(estado sin nombre)")
                                            @if (!string.IsNullOrWhiteSpace(estado.Name) && string.Equals(estado.Name, _vistaEnProgreso.Spec.InitialState, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="viewspec-badge">Estado inicial</span>
                                            }
                                        </div>
                                        @foreach (var fila in estado.Rows ?? Array.Empty<ViewSpecRow>())
                                        {
                                            @if (!string.IsNullOrWhiteSpace(fila.Name))
                                            {
                                                <div class="viewspec-summary-detail">Fila: @fila.Name</div>
                                            }
                                            @foreach (var area in fila.Areas ?? Array.Empty<ViewSpecArea>())
                                            {
                                                <div class="viewspec-area">
                                                    <div class="viewspec-area-type">@(area.Type ?? "Área")</div>
                                                    @if (!string.IsNullOrWhiteSpace(area.Name))
                                                    {
                                                        <div class="viewspec-summary-detail">Área: @area.Name</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(area.ObjectName))
                                                    {
                                                        <div class="viewspec-summary-detail">Objeto: @area.ObjectName</div>
                                                    }
                                                    <div class="viewspec-area-detail viewspec-summary-detail">Stored Procedure: @(string.IsNullOrWhiteSpace(area.StoredProcedure) ? "pendiente" : area.StoredProcedure)</div>
                                                    @if (!string.IsNullOrWhiteSpace(area.ConnectionAlias))
                                                    {
                                                        <div class="viewspec-summary-detail">Alias de conexión: @area.ConnectionAlias</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(area.ConfigurationPreset))
                                                    {
                                                        <div class="viewspec-summary-detail">Preset de configuración: @area.ConfigurationPreset</div>
                                                    }
                                                    @foreach (var parametro in area.Parameters ?? Array.Empty<ViewSpecParameter>())
                                                    {
                                                        <div class="viewspec-summary-detail">Parámetro con valor fijo: @parametro?.Name = «@parametro?.DefaultValue»</div>
                                                    }
                                                    @foreach (var handler in area.Handlers ?? Array.Empty<ViewSpecHandler>())
                                                    {
                                                        <div class="viewspec-handler">@(handler.Type ?? "Handler") → @(handler.TargetState ?? "pendiente")</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                                <div class="viewspec-validation">
                                    <span class="context-panel-section-title">Validación</span>
                                    @if (_vistaEnProgreso.Validation.IsValid && _vistaEnProgreso.Validation.Pending.Count == 0)
                                    {
                                        <div class="viewspec-validation-ok">✓ estructura válida</div>
                                    }
                                    else
                                    {
                                        <div class="viewspec-validation-warning">⚠ faltan datos</div>
                                    }

                                    @if (_vistaEnProgreso.Validation.Errors.Count > 0)
                                    {
                                        <ul class="viewspec-pending-list">
                                            @foreach (var error in _vistaEnProgreso.Validation.Errors)
                                            {
                                                <li>@error</li>
                                            }
                                        </ul>
                                    }

                                    @if (_vistaEnProgreso.Validation.Pending.Count > 0)
                                    {
                                        <span class="viewspec-pending-title">Pendientes:</span>
                                        <ul class="viewspec-pending-list">
                                            @foreach (var pendiente in _vistaEnProgreso.Validation.Pending)
                                            {
                                                <li>@pendiente</li>
                                            }
                                        </ul>
                                    }
                                </div>

                                @if (_vistaEnProgreso.KnowledgeGaps is { Count: > 0 })
                                {
                                    <div class="viewspec-knowledge-gaps">
                                        <span class="context-panel-section-title">Conocimiento faltante</span>
                                        @foreach (var gap in _vistaEnProgreso.KnowledgeGaps)
                                        {
                                            <div class="viewspec-knowledge-gap">
                                                <div class="viewspec-knowledge-gap-topic">⚠ @gap.Topic</div>
                                                <div class="viewspec-knowledge-gap-description">@gap.Description</div>
                                                <button type="button" class="viewspec-knowledge-gap-action" @onclick="@(() => AbrirFormularioEnsenar(gap))">Enseñar a DesignerIA</button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="viewspec-actions">
                                    <button type="button" class="viewspec-action"
                                            disabled="@(_generandoScript || _vistaEnProgreso.Validation.Errors.Count > 0)"
                                            title="@(_vistaEnProgreso.Validation.Errors.Count > 0 ? "La vista tiene errores estructurales" : "Generar script SQL de sólo previsualización")"
                                            @onclick="GenerarScriptAsync">
                                        @(_generandoScript ? "Generando..." : "Generar script")
                                    </button>
                                    <button type="button" class="viewspec-action"
                                            disabled="@(_creandoVista || _confirmandoCreacion || _generandoScript || _vistaEnProgreso.Validation.Errors.Count > 0)"
                                            title="@(_vistaEnProgreso.Validation.Errors.Count > 0 ? "La vista tiene errores estructurales" : "Crear la vista en la base de metadata")"
                                            @onclick="PedirConfirmacionCrear">
                                        @(_creandoVista ? "Creando..." : "Crear vista")
                                    </button>
                                </div>

                                @if (_confirmandoCreacion)
                                {
                                    <div class="viewcreation-confirm">
                                        <div>Se creará la vista «@_vistaEnProgreso.Spec.Name» en la base de metadata. DesignerIA no puede deshacerla.</div>
                                        <div class="viewspec-actions">
                                            <button type="button" class="viewspec-action" @onclick="CrearVistaAsync">Confirmar creación</button>
                                            <button type="button" class="viewspec-action" @onclick="CancelarConfirmacionCrear">Cancelar</button>
                                        </div>
                                    </div>
                                }

                                @if (_resultadoScript is not null)
                                {
                                    <div class="viewscript-panel">
                                        @if (_resultadoScript.CanGenerate)
                                        {
                                            <div class="viewscript-status-ok">Script generado. No ejecutado.</div>
                                            <button type="button" class="viewscript-copy-button" @onclick="CopiarScriptAsync">Copiar</button>
                                            <pre class="viewscript-code">@_resultadoScript.Script</pre>
                                        }
                                        else
                                        {
                                            <div class="viewscript-status-warning">No se puede generar todavía:</div>
                                            <ul class="viewspec-pending-list">
                                                @foreach (var gap in _resultadoScript.Gaps)
                                                {
                                                    <li><strong>@gap.Topic:</strong> @gap.Description</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Progreso y resultado de la creación: no dependen de la vista en progreso ni de la
                       conversación, porque describen una escritura que ya pudo ocurrir en la base. *@
                    @if (_creandoVista || _resultadoCreacion is not null)
                    {
                        <div>
                            <RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="context-panel-section-title">Creación de vista</RadzenText>
                            <div class="viewscript-panel">
                                @if (_creandoVista)
                                {
                                    <div class="viewscript-status-warning">Creando «@_nombreCreacion»… Espera el resultado.</div>
                                }
                                else if (_resultadoCreacion is not null)
                                {
                                    <div class="@(_resultadoCreacion.Status == ViewCreationStatus.Created ? "viewscript-status-ok" : "viewscript-status-warning")">
                                        «@_nombreCreacion»: @_resultadoCreacion.Message
                                    </div>
                                    @if (_resultadoCreacion.Status == ViewCreationStatus.Created && !string.IsNullOrWhiteSpace(_resultadoCreacion.ViewUrl))
                                    {
                                        <a class="viewcreation-open-link" href="@_resultadoCreacion.ViewUrl" target="_blank" rel="noopener noreferrer">@(_resultadoCreacion.ViewUrlIsMock ? "Abrir enlace de referencia (mock)" : "Abrir vista")</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_scriptCreacionJson))
                                    {
                                        <details>
                                            <summary>Script de creación</summary>
                                            <button type="button" class="viewscript-copy-button" @onclick="CopiarScriptJsonAsync">Copiar</button>
                                            <pre class="viewscript-code">@_scriptCreacionJson</pre>
                                        </details>
                                    }
                                    @if (_resultadoCreacion.Gaps.Count > 0)
                                    {
                                        <ul class="viewspec-pending-list">
                                            @foreach (var gap in _resultadoCreacion.Gaps)
                                            {
                                                <li><strong>@gap.Topic:</strong> @gap.Description</li>
                                            }
                                        </ul>
                                    }
                                    @if (_resultadoCreacion.Diagnostics.Count > 0)
                                    {
                                        <details class="viewcreation-diagnostics">
                                            <summary>Diagnóstico</summary>
                                            <ul class="viewspec-pending-list">
                                                @foreach (var linea in _resultadoCreacion.Diagnostics)
                                                {
                                                    <li>@linea</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                    <button type="button" class="viewscript-copy-button" @onclick="OcultarResultadoCreacion">Ocultar</button>
                                }
                            </div>
                        </div>
                    }
                </RadzenStack>
            </RadzenCard>
        </aside>
    </div>
</div>

@if (_mostrarCrearVistaJson)
{
    <JsonMetadataCreateDialog ReplacesDraft="@(_edicionVista.Content is not null)" OnClose="@(() => _mostrarCrearVistaJson = false)" OnLoaded="CargarBorradorVista" />
}

@if (_mostrarFormularioEnsenar)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-title">Enseñar a DesignerIA</div>
            <div class="modal-body">
                <label class="modal-label">Tema</label>
                <input class="modal-input" @bind="_temaEnsenar" />

                <label class="modal-label">Explicación</label>
                <textarea class="modal-textarea" rows="4" @bind="_explicacionEnsenar"></textarea>

                <label class="modal-label">Ejemplo (opcional)</label>
                <textarea class="modal-textarea" rows="2" @bind="_ejemploEnsenar"></textarea>

                <label class="modal-label">Aportado por</label>
                <input class="modal-input" @bind="_aportadoPorEnsenar" />

                @if (!string.IsNullOrWhiteSpace(_mensajeEnsenar))
                {
                    <div class="modal-message">@_mensajeEnsenar</div>
                }
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-button-secondary" @onclick="CerrarFormularioEnsenar">Cerrar</button>
                <button type="button" class="modal-button-primary" disabled="@_guardandoEnsenar" @onclick="GuardarConocimientoAsync">
                    @(_guardandoEnsenar ? "Guardando..." : "Guardar para revisión")
                </button>
            </div>
        </div>
    </div>
}

@if (_mostrarLaboratorio)
{
    <div class="modal-overlay">
        <div class="modal-dialog modal-dialog-wide">
            <div class="modal-title">Laboratorio de conocimiento</div>
            <div class="modal-body">
                @if (_cargandoLaboratorio)
                {
                    <div class="modal-message">Cargando...</div>
                }
                else if (_entradasPendientesLaboratorio.Count == 0)
                {
                    <div class="modal-message">No hay entradas pendientes de revisión.</div>
                }
                else
                {
                    @foreach (var entrada in _entradasPendientesLaboratorio)
                    {
                        <div class="lab-entry">
                            <div class="lab-entry-topic">@entrada.Topic</div>
                            <div class="lab-entry-content">@entrada.Content</div>
                            @if (!string.IsNullOrWhiteSpace(entrada.Example))
                            {
                                <div class="lab-entry-example">Ejemplo: @entrada.Example</div>
                            }
                            <div class="lab-entry-meta">Aportado por: @entrada.Contributor · @entrada.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                            <input class="modal-input" placeholder="Revisado por" @bind="@_revisadoPorPorEntrada[entrada.Id]" />
                            <div class="lab-entry-actions">
                                <button type="button" class="modal-button-primary" @onclick="@(() => AprobarAsync(entrada.Id))">Aprobar</button>
                                <button type="button" class="modal-button-secondary" @onclick="@(() => RechazarAsync(entrada.Id))">Rechazar</button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-button-secondary" @onclick="CerrarLaboratorio">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string[] _promptStarters =
    {
        "¿Cuántas vistas existen actualmente?",
        "¿Qué puede hacer DesignerIA actualmente?",
    };

    private record ChatMessage(
        string Texto,
        bool EsUsuario,
        bool ToolInvoked,
        bool EsError,
        IReadOnlyList<KnowledgeSourceReference>? Fuentes = null,
        bool EsCreacionVista = false,
        bool VistaValida = false,
        string? NombreVista = null)
    {
        public MarkupString Html { get; } = !EsUsuario && !EsError && !EsCreacionVista
            ? MarkdownChatRenderer.Render(Texto) : default;
    }

    private readonly List<ChatMessage> _mensajes = new();
    private string _conversationId = Guid.NewGuid().ToString();
    private string _mensajeActual = string.Empty;
    private bool _enviando;
    private ChatResult? _ultimoResultadoChat;

    // Vive únicamente en memoria durante esta fase (sin persistencia): una nueva
    // petición de creación de vista dentro de la misma página reemplaza la actual.
    private ViewSpecResult? _vistaEnProgreso;

    // ---- ViewScriptGen: generación determinística de SQL de sólo previsualización ----
    private bool _generandoScript;
    private ViewScriptGenerationResult? _resultadoScript;

    // ---- Creación de la vista: el SQL se genera y ejecuta en la API; aquí sólo viaja el ViewSpec ----
    private bool _confirmandoCreacion;
    private bool _creandoVista;
    private ViewCreationResult? _resultadoCreacion;
    private string? _scriptCreacionJson;
    private string? _nombreCreacion;

    // El borrador y la conversación conservan estados separados al cambiar de sección.
    private bool _mostrarCrearVistaJson;
    private JsonMetadataEditingState _edicionVista = new();
    private string? _archivoVista;
    private bool _seccionVista;
    private bool _asistenteVisible;
    private bool _editorAmpliado;
    private bool _editorOcupado;

    private void MostrarConversaciones()
    {
        if (_editorOcupado) { return; }
        _seccionVista = false;
        _editorAmpliado = false;
    }

    private void AbrirPreparacion()
    {
        if (_editorOcupado || _creandoVista) { return; }
        if (_edicionVista.Content is null) { _mostrarCrearVistaJson = true; }
        else { _seccionVista = true; }
    }

    private void CargarBorradorVista((string FileName, string Content) loaded)
    {
        if (_editorOcupado) { return; }
        _edicionVista = new();
        _edicionVista.EditText(loaded.Content);
        _archivoVista = loaded.FileName;
        _mostrarCrearVistaJson = false;
        _seccionVista = true;
        _editorAmpliado = false;
    }

    private bool _actualizandoConocimiento;
    private KnowledgeRebuildResult? _ultimoRebuild;

    // ---- Enseñar a DesignerIA ----
    private bool _mostrarFormularioEnsenar;
    private string _temaEnsenar = string.Empty;
    private string _explicacionEnsenar = string.Empty;
    private string _ejemploEnsenar = string.Empty;
    private string _aportadoPorEnsenar = string.Empty;
    private bool _guardandoEnsenar;
    private string? _mensajeEnsenar;

    // ---- Laboratorio de conocimiento ----
    private bool _mostrarLaboratorio;
    private bool _cargandoLaboratorio;
    private List<CuratedKnowledgeEntry> _entradasPendientesLaboratorio = new();
    private readonly Dictionary<string, string> _revisadoPorPorEntrada = new();

    private HealthStatus? _estado;
    private bool _cargando = true;

    private DatabaseHealthStatus? _estadoBaseDatos;
    private bool _cargandoBaseDatos = true;

    private IdentityStatus? _identidadApi;
    private bool _cargandoIdentidadApi = true;

    private string EstadoApi => _cargando ? "loading" : _estado is not null ? "ok" : "error";
    private string EtiquetaApi => _cargando ? "Consultando..." : _estado is not null ? "Disponible" : "No disponible";

    private string EstadoGestionEngine => _cargandoBaseDatos ? "loading" : _estadoBaseDatos is not null ? "ok" : "error";
    private string EtiquetaGestionEngine => _cargandoBaseDatos ? "Consultando..." : _estadoBaseDatos is not null ? "Disponible" : "No disponible";

    private string EstadoCopilot =>
        _enviando ? "loading" :
        _ultimoResultadoChat?.Status == "ok" ? "ok" :
        _ultimoResultadoChat is not null ? "error" : "pending";

    private string EtiquetaCopilot =>
        _enviando ? "Procesando..." :
        _ultimoResultadoChat?.Status == "ok" ? "Disponible" :
        _ultimoResultadoChat is not null ? "Error" : "Sin probar";

    private static string ClaseBadge(string estado) => estado switch
    {
        "ok" => "status-badge-ok",
        "error" => "status-badge-error",
        "loading" => "status-badge-loading",
        _ => "status-badge-pending",
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            ConsultarEstadoAsync(),
            ConsultarEstadoBaseDatosAsync(),
            ConsultarIdentidadApiAsync());
    }

    private async Task ConsultarEstadoAsync()
    {
        _cargando = true;
        _estado = null;
        try
        {
            _estado = await Http.GetFromJsonAsync<HealthStatus>("api/health");
        }
        catch
        {
            _estado = null;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GenerarScriptAsync()
    {
        if (_vistaEnProgreso is null || _generandoScript)
        {
            return;
        }

        var vista = _vistaEnProgreso;
        _generandoScript = true;
        _resultadoScript = null;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/view-script/generate", vista.Spec);
            if (respuesta.IsSuccessStatusCode)
            {
                var resultado = await respuesta.Content.ReadFromJsonAsync<ViewScriptGenerationResult>();
                if (ReferenceEquals(_vistaEnProgreso, vista))
                {
                    _resultadoScript = resultado;
                }
            }
        }
        catch
        {
            if (ReferenceEquals(_vistaEnProgreso, vista))
            {
                _resultadoScript = null;
            }
        }
        finally
        {
            _generandoScript = false;
        }
    }

    private void PedirConfirmacionCrear()
    {
        if (_vistaEnProgreso is not null && !_creandoVista)
        {
            _confirmandoCreacion = true;
        }
    }

    private void CancelarConfirmacionCrear() => _confirmandoCreacion = false;

    private void OcultarResultadoCreacion()
    {
        if (!_creandoVista)
        {
            _resultadoCreacion = null;
        }
    }

    private async Task CrearVistaAsync()
    {
        // _creandoVista evita un doble envío mientras la API responde.
        if (_vistaEnProgreso is null || _creandoVista)
        {
            return;
        }

        var vista = _vistaEnProgreso;
        _creandoVista = true;
        _confirmandoCreacion = false;
        _resultadoCreacion = null;
        _scriptCreacionJson = null;
        _nombreCreacion = vista.Spec.Name;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/view-script/create", vista.Spec);
            // 200, 403 y 409 traen un ViewCreationResult. El resultado se muestra aunque la vista
            // en progreso haya cambiado: describe una escritura que ya pudo ocurrir.
            if (respuesta.StatusCode is System.Net.HttpStatusCode.OK or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Conflict)
            {
                var opciones = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
                opciones.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
                _resultadoCreacion = await respuesta.Content.ReadFromJsonAsync<ViewCreationResult>(opciones);
            }
            _resultadoCreacion ??= ResultadoCreacionSinRespuesta($"La API respondió {(int)respuesta.StatusCode}.");
        }
        catch (Exception excepcion)
        {
            _resultadoCreacion = ResultadoCreacionSinRespuesta($"No se recibió la respuesta de la API ({excepcion.GetType().Name}).");
        }
        finally
        {
            _creandoVista = false;
        }
    }

    // La API no cancela una creación porque se pierda la petición: sin respuesta, el resultado no se conoce.
    private static ViewCreationResult ResultadoCreacionSinRespuesta(string detalle) => new(
        ViewCreationStatus.Indeterminate, null,
        "No se pudo confirmar si la vista se creó. Comprueba la base antes de volver a intentarlo.", [], [detalle]);

    // Sin respuesta de la API el resultado no se conoce, igual que en la creación desde la vista en progreso.
    private async Task MostrarResultadoCreacionJson((string? ViewId, ViewCreationResult? Result, string? Detail, string? Script) creacion)
    {
        _nombreCreacion = creacion.ViewId;
        _resultadoCreacion = creacion.Result ?? ResultadoCreacionSinRespuesta(creacion.Detail ?? "No se recibió la respuesta de la API.");
        _scriptCreacionJson = creacion.Script;
        _mostrarCrearVistaJson = false;
        MostrarConversaciones();
        if (_resultadoCreacion.Status == ViewCreationStatus.Created)
        {
            await ConsultarEstadoBaseDatosAsync();
        }
    }

    private async Task CopiarScriptJsonAsync()
    {
        if (_scriptCreacionJson is { Length: > 0 } script)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", script);
        }
    }

    private async Task CopiarScriptAsync()
    {
        if (_resultadoScript?.Script is { Length: > 0 } script)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", script);
        }
    }

    private async Task ConsultarEstadoBaseDatosAsync()
    {
        _cargandoBaseDatos = true;
        _estadoBaseDatos = null;
        try
        {
            var respuesta = await Http.GetAsync("api/database/health");
            if (respuesta.IsSuccessStatusCode)
            {
                _estadoBaseDatos = await respuesta.Content.ReadFromJsonAsync<DatabaseHealthStatus>();
            }
            else
            {
                _estadoBaseDatos = null;
            }
        }
        catch
        {
            _estadoBaseDatos = null;
        }
        finally
        {
            _cargandoBaseDatos = false;
        }
    }

    private async Task ConsultarIdentidadApiAsync()
    {
        _cargandoIdentidadApi = true;
        _identidadApi = null;
        try
        {
            var respuesta = await Http.GetAsync("api/health/identity");
            if (respuesta.IsSuccessStatusCode)
            {
                _identidadApi = await respuesta.Content.ReadFromJsonAsync<IdentityStatus>();
            }
        }
        catch
        {
            _identidadApi = null;
        }
        finally
        {
            _cargandoIdentidadApi = false;
        }
    }

    private void NuevaConversacion()
    {
        _mensajes.Clear();
        _conversationId = Guid.NewGuid().ToString();
        _mensajeActual = string.Empty;
        _ultimoResultadoChat = null;
        _vistaEnProgreso = null;
        _resultadoScript = null;
        _confirmandoCreacion = false;
        // El progreso y el resultado de una creación se conservan: no pertenecen a la conversación.
    }

    private Task EnviarStarterAsync(string texto)
    {
        _mensajeActual = texto;
        return EnviarAsync();
    }

    private async Task EnviarAsync()
    {
        var texto = _mensajeActual.Trim();
        if (string.IsNullOrWhiteSpace(texto) || _enviando)
        {
            return;
        }

        _mensajes.Add(new ChatMessage(texto, EsUsuario: true, ToolInvoked: false, EsError: false));
        _mensajeActual = string.Empty;
        _enviando = true;

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/copilot/chat", new ChatRequest(texto, _conversationId));
            if (_estado is null)
            {
                // La Api volvió a responder tras un fallo de contacto: se refresca el indicador.
                await ConsultarEstadoAsync();
            }

            var resultado = await respuesta.Content.ReadFromJsonAsync<ChatResult>();
            _ultimoResultadoChat = resultado;

            if (resultado is not null && resultado.Status == "ok")
            {
                var esCreacionVista = resultado.ViewSpecResult is not null;
                _mensajes.Add(new ChatMessage(
                    resultado.Response ?? string.Empty,
                    EsUsuario: false,
                    ToolInvoked: resultado.ToolInvoked,
                    EsError: false,
                    Fuentes: resultado.Sources,
                    EsCreacionVista: esCreacionVista,
                    VistaValida: resultado.ViewSpecResult?.Validation.IsValid == true && resultado.ViewSpecResult.Validation.Pending.Count == 0,
                    NombreVista: resultado.ViewSpecResult?.Spec.Name));

                if (resultado.ViewSpecResult is not null)
                {
                    _vistaEnProgreso = resultado.ViewSpecResult;
                    _resultadoScript = null;
                    _confirmandoCreacion = false;
                }
            }
            else
            {
                _mensajes.Add(new ChatMessage(resultado?.Error ?? "DesignerIA no pudo responder.", EsUsuario: false, ToolInvoked: false, EsError: true));
            }
        }
        catch (Exception ex)
        {
            if (ex is HttpRequestException or TaskCanceledException)
            {
                // Sin respuesta HTTP (red o timeout): el indicador no puede seguir en "Disponible".
                _estado = null;
            }

            _ultimoResultadoChat = new ChatResult("error", null, false, "No se pudo contactar a la Api.");
            _mensajes.Add(new ChatMessage("No se pudo contactar a la Api.", EsUsuario: false, ToolInvoked: false, EsError: true));
        }
        finally
        {
            _enviando = false;
        }
    }

    private async Task ActualizarConocimientoAsync()
    {
        if (_actualizandoConocimiento)
        {
            return;
        }

        _actualizandoConocimiento = true;
        try
        {
            var respuesta = await Http.PostAsync("api/knowledge/rebuild", null);
            _ultimoRebuild = await respuesta.Content.ReadFromJsonAsync<KnowledgeRebuildResult>();
        }
        catch
        {
            _ultimoRebuild = new KnowledgeRebuildResult("error", 0, 0, 0, 0, 0, 0, Error: "No se pudo contactar a la Api.");
        }
        finally
        {
            _actualizandoConocimiento = false;
        }
    }

    private void AbrirFormularioEnsenar(ViewSpecKnowledgeGap gap)
    {
        _temaEnsenar = gap.Topic;
        _explicacionEnsenar = string.Empty;
        _ejemploEnsenar = string.Empty;
        _aportadoPorEnsenar = string.Empty;
        _mensajeEnsenar = null;
        _mostrarFormularioEnsenar = true;
    }

    private void CerrarFormularioEnsenar()
    {
        _mostrarFormularioEnsenar = false;
    }

    private async Task GuardarConocimientoAsync()
    {
        if (_guardandoEnsenar)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_temaEnsenar) || string.IsNullOrWhiteSpace(_explicacionEnsenar) || string.IsNullOrWhiteSpace(_aportadoPorEnsenar))
        {
            _mensajeEnsenar = "Tema, Explicación y Aportado por son requeridos.";
            return;
        }

        _guardandoEnsenar = true;
        try
        {
            var request = new CuratedKnowledgeCreateRequest(
                _temaEnsenar.Trim(),
                _explicacionEnsenar.Trim(),
                string.IsNullOrWhiteSpace(_ejemploEnsenar) ? null : _ejemploEnsenar.Trim(),
                _aportadoPorEnsenar.Trim());

            var respuesta = await Http.PostAsJsonAsync("api/knowledge/curated", request);
            var resultado = await respuesta.Content.ReadFromJsonAsync<CuratedKnowledgeResult>();

            _mensajeEnsenar = resultado?.Status == "ok"
                ? "Conocimiento guardado para revisión. Todavía no será utilizado por DesignerIA."
                : resultado?.Error ?? "No se pudo guardar el conocimiento aportado.";
        }
        catch
        {
            _mensajeEnsenar = "No se pudo contactar a la Api.";
        }
        finally
        {
            _guardandoEnsenar = false;
        }
    }

    private async Task AbrirLaboratorioAsync()
    {
        _mostrarLaboratorio = true;
        await CargarPendientesLaboratorioAsync();
    }

    private void CerrarLaboratorio()
    {
        _mostrarLaboratorio = false;
    }

    private async Task CargarPendientesLaboratorioAsync()
    {
        _cargandoLaboratorio = true;
        try
        {
            var jsonOptions = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
            jsonOptions.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
            var resultado = await Http.GetFromJsonAsync<CuratedKnowledgeListResult>("api/knowledge/curated?status=Pending", jsonOptions);
            _entradasPendientesLaboratorio = resultado?.Entries?.ToList() ?? new List<CuratedKnowledgeEntry>();
        }
        catch
        {
            _entradasPendientesLaboratorio = new List<CuratedKnowledgeEntry>();
        }
        finally
        {
            _cargandoLaboratorio = false;
        }
    }

    private async Task AprobarAsync(string id)
    {
        var revisadoPor = _revisadoPorPorEntrada.GetValueOrDefault(id, string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(revisadoPor))
        {
            return;
        }

        await Http.PostAsJsonAsync($"api/knowledge/curated/{id}/approve", new CuratedKnowledgeReviewRequest(revisadoPor));
        await CargarPendientesLaboratorioAsync();
    }

    private async Task RechazarAsync(string id)
    {
        var revisadoPor = _revisadoPorPorEntrada.GetValueOrDefault(id, string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(revisadoPor))
        {
            return;
        }

        await Http.PostAsJsonAsync($"api/knowledge/curated/{id}/reject", new CuratedKnowledgeReviewRequest(revisadoPor));
        await CargarPendientesLaboratorioAsync();
    }
}
